<?xml version="1.0" encoding="utf-8"?>
<!--
  D3DX (d3dx9.h / d3dx9.lib) location.

  If the DirectX SDK (June 2010) is installed, DXSDK_DIR points at it and is used as before.
  Otherwise the copy of Microsoft's "Microsoft.DXSDK.D3DX" NuGet package vendored under
  core\third-party\d3dx is used, so nothing has to be installed to build.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <D3DXIncludeDir Condition="'$(D3DXIncludeDir)'=='' and '$(DXSDK_DIR)'!=''">$(DXSDK_DIR)Include</D3DXIncludeDir>
    <D3DXLibDir Condition="'$(D3DXLibDir)'=='' and '$(DXSDK_DIR)'!=''">$(DXSDK_DIR)Lib\x86</D3DXLibDir>
    <D3DXIncludeDir Condition="'$(D3DXIncludeDir)'==''">$(SolutionDir)core\third-party\d3dx\build\native\include</D3DXIncludeDir>
    <D3DXLibDir Condition="'$(D3DXLibDir)'==''">$(SolutionDir)core\third-party\d3dx\build\native\release\lib\x86</D3DXLibDir>
    <D3DXRedistDir Condition="'$(D3DXRedistDir)'==''">$(SolutionDir)core\third-party\d3dx\build\native\release\bin\x86</D3DXRedistDir>
  </PropertyGroup>
</Project>
